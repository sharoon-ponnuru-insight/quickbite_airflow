config {
  type: "incremental",
  schema: dataform.projectConfig.vars.core_dataset,
  name: "fct_orders",
  uniqueKey: ["order_id"],
  bigquery: {
    partitionBy: "order_date",
    clusterBy: ["city", "restaurant_id", "status"]
  },
  assertions: {
    uniqueKey: ["order_id"],
    nonNull: ["order_id", "customer_id", "restaurant_id"]
  }
}

WITH valid_orders AS (
  SELECT
    o.order_id,
    o.customer_id,
    o.restaurant_id,
    r.city,
    o.order_ts,
    o.order_date,
    CASE 
      WHEN o.status IN ('placed', 'preparing', 'out_for_delivery', 'delivered', 'cancelled') THEN o.status
      ELSE 'unknown'
    END AS status,
    o.payment_method,
    o.updated_at,
    ROW_NUMBER() OVER (PARTITION BY o.order_id ORDER BY o.updated_at DESC, o._ingested_at DESC) AS rn
  FROM \${ref("stg_orders")} o
  INNER JOIN \${ref("dim_restaurants")} r ON o.restaurant_id = r.restaurant_id
  WHERE o.customer_id IS NOT NULL
)

SELECT
  order_id,
  customer_id,
  restaurant_id,
  city,
  order_ts,
  order_date,
  status,
  payment_method,
  updated_at
FROM valid_orders
WHERE rn = 1

\${when(incremental(), `AND updated_at > (SELECT MAX(updated_at) FROM ${self()})`)}