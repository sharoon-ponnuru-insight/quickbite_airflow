config {
  type: "table",
  schema: dataform.projectConfig.vars.marts_dataset,
  name: "mart_restaurant_performance"
}

WITH order_aggregates AS (
  SELECT
    o.restaurant_id,
    COUNT(o.order_id) AS total_orders,
    COUNTIF(o.status = 'delivered') AS delivered_orders,
    COUNTIF(o.status = 'cancelled') AS cancelled_orders,
    SUM(CASE WHEN o.status = 'delivered' THEN i.line_item_revenue ELSE 0 END) AS gross_revenue
  FROM ${ref("fct_orders")} o
  LEFT JOIN ${ref("fct_order_items")} i ON o.order_id = i.order_id
  GROUP BY 1
)

SELECT
  r.restaurant_id,
  r.restaurant_name,
  r.city,
  r.is_active,
  COALESCE(oa.total_orders, 0) AS total_orders,
  COALESCE(oa.delivered_orders, 0) AS delivered_orders,
  COALESCE(oa.cancelled_orders, 0) AS cancelled_orders,
  ROUND(
    SAFE_DIVIDE(COALESCE(oa.cancelled_orders, 0), COALESCE(oa.total_orders, 0)) * 100, 
    2
  ) AS cancellation_rate_pct,
  COALESCE(oa.gross_revenue, 0) AS gross_revenue
FROM ${ref("dim_restaurants")} r
LEFT JOIN order_aggregates oa ON r.restaurant_id = oa.restaurant_id