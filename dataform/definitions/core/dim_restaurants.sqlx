config {
  type: "table",
  schema: dataform.projectConfig.vars.core_dataset,
  name: "dim_restaurants",
  assertions: {
    uniqueKey: ["restaurant_id"],
    nonNull: ["restaurant_id"]
  }
}

SELECT
  restaurant_id,
  restaurant_name,
  city,
  cuisine,
  is_active,
  onboarded_date
FROM ${ref("stg_restaurants")}
QUALIFY ROW_NUMBER() OVER (PARTITION BY restaurant_id ORDER BY _ingested_at DESC) = 1